<%# Scrollspy : marque le lien TOC actif selon la section visible. %>
<script type="module"<% if(nonce) { %> nonce="<%=nonce%>"<% } %>>
  // Map id de section → lien TOC correspondant (href="#id")
  const tocLinks  = document.querySelectorAll('.docs-toc-link[href^="#"]')
  const linksById = {}
  tocLinks.forEach(a => { linksById[a.getAttribute('href').slice(1)] = a })

  // Sections de niveau 1 uniquement (chaque <section id="..."> direct dans .docs-content)
  const sections = document.querySelectorAll('.docs-content > section[id]')

  // IntersectionObserver : on retient la section dont le top est le plus
  // proche (sans le dépasser) du seuil. rootMargin pousse le seuil sous
  // le header sticky pour suivre le scroll naturel.
  let current = null
  function setActive(id) {
    if(id === current) return
    current = id
    tocLinks.forEach(a => { a.classList.remove('is-active') })
    if(linksById[id]) linksById[id].classList.add('is-active')
  }

  const io = new IntersectionObserver(entries => {
    // Récupère toutes les sections visibles et prend celle dont le top est
    // le plus haut (celle qu'on est en train de lire).
    const visible = entries.filter(e => e.isIntersecting)
    if(!visible.length) return
    visible.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)
    setActive(visible[0].target.id)
  }, {
    rootMargin: '-80px 0px -60% 0px',  // header sticky 80px en haut, 60% du bas ignoré
    threshold: 0
  })
  sections.forEach(s => { io.observe(s) })
</script>

