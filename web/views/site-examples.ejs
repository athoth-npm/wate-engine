 * \brief     Page /examples. Les blocs sont pré-construits dans des variables
 *            EJS (blocs < % % >) puis injectés en attributs avec < % =var% >.
 */
var G = result
var L = {
  explain: _gi(G,'ex-explain-label'), preview: _gi(G,'ex-result-label'),
  routeL:  _gi(G,'preview-route'),    status:  _gi(G,'preview-status'),
  path:    _gi(G,'pipeline-title'),
  pexpr:   _gi(G,'pipe-express'),     proute:  _gi(G,'pipe-route'),
  ppage:   _gi(G,'pipe-page'),        pquery:  _gi(G,'pipe-queries'),
  phook:   _gi(G,'pipe-hook'),        prender: _gi(G,'pipe-render')
}

// _s(g, fn, n, classes) — construit les blocs de code HTML.
// g=result, fn=_gi, n=numéro exemple, classes=['sql','ejs',...]
// Passage explicite pour éviter les closures instables avec le 'with' EJS.
function _s(g, fn, n, classes) {
  var h = '', k, txt
  for(var i = 0; i < classes.length; i++) {
    k = i + 1
    h += '<div class=code-sublabel>'+fn(g,'ex'+n+'-sublabel-'+k)+'</div>'
    txt = fn(g,'ex'+n+'-code-'+k)
    // Échappe < > & pour affichage dans <pre><code> — la 1re couche
    // d'échappement (attribut HTML) est annulée par le navigateur.
    txt = txt.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    h += '<pre><code class="'+classes[i]+'">'+txt+'</code></pre>'
  }
  return h
}

// Blocs de code et previews pré-construits
var cb1 = _s(G, _gi, 1, ['sql','ejs'])
var pv1 = '<h3 class=preview-h1>Bonjour</h3><p class=preview-p>'+_gi(G,'preview-hello')+'</p>'

var cb2 = _s(G, _gi, 2, ['sql','ejs'])
var pv2 = '<h3 class=preview-h1>'+_gi(G,'ex2-preview-h')+'</h3><p class=preview-p>'+_gi(G,'ex2-preview-p')+'</p>'

var cb3 = _s(G, _gi, 3, ['sql','ejs'])
var pv3 = '<ul class=preview-list><li><strong>Bol émaillé</strong> — 14,50 €</li><li><strong>Carafe en grès</strong> — 24,00 €</li><li><strong>Plateau en chêne</strong> — 38,00 €</li></ul>'

var cb4 = _s(G, _gi, 4, ['js','sql','ejs'])
var pv4 = '<h3 class=preview-h1>'+_gi(G,'ex4-preview-h')+'</h3><p class=preview-p>'+_gi(G,'ex4-preview-p')+'</p>'

var cb5 = _s(G, _gi, 5, ['js','sql','ejs'])
var pv5 = '<h3 class=preview-h1>'+_gi(G,'ex5-preview-h')+'</h3><p class=preview-p>'+_gi(G,'ex5-preview-p')+'</p>'

var cb6 = _s(G, _gi, 6, ['sql','bash'])
var pv6 = '<h3 class=preview-h1>'+_gi(G,'ex6-preview-h')+'</h3><p class=preview-p>'+_gi(G,'ex6-preview-p')+'</p>'

var cb7 = _s(G, _gi, 7, ['sql','bash'])
var pv7 = '<h3 class=preview-h1>'+_gi(G,'ex7-preview-h')+'</h3><p class=preview-p>'+_gi(G,'ex7-preview-p')+'</p>'
%>
